# ========================================================
# CONFIGURAÇÃO DE IA GENERATIVA - AFESUTECH (AFESU / SENAI-SP)
# ========================================================

# Chave de API da Groq (obtenha gratuitamente em console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Modelo Generativo da Groq (Llama 3.3 70B Versatile - Ultra rápido)
GROQ_MODEL=llama-3.3-70b-versatile

# Temperatura de criatividade (0.0 mais determinístico, 0.7 mais conversacional)
TEMPERATURE=0.7
